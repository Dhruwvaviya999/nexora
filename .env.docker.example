# =============================================================================
# docker compose environment
# -----------------------------------------------------------------------------
# Copy to `.env` in this directory:  cp .env.docker.example .env
# Compose reads it automatically. This file is for the *stack*; the backend's
# own backend/.env is only used when running it outside Docker.
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,web
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Leave False unless TLS terminates at this service rather than a proxy.
SECURE_SSL_REDIRECT=False

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora

# -----------------------------------------------------------------------------
# Ports on the host
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Inlined into the browser bundle at build time, so it must be reachable from
# the browser -- not the internal "web" hostname.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# The default prints messages to the container log, which is fine for a demo.
# For real delivery switch the backend and fill in the SMTP settings.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Nexora <no-reply@nexora.app>

# -----------------------------------------------------------------------------
# AI (optional)
# -----------------------------------------------------------------------------
# Embeddings run locally and need no key. A chat provider key is only required
# for the assistant itself.
AI_LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Fernet key encrypting per-workspace API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_FIELD_ENCRYPTION_KEY=
