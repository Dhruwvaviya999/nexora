# =============================================================================
# Docker Compose environment — read by compose, not by Django
# -----------------------------------------------------------------------------
# Read by:   docker compose, which auto-loads the .env sitting next to
#            docker-compose.yml and substitutes ${VAR} references in it.
# Used when: you run `docker compose up`.
# Ignored:   when you run Django directly — that reads backend/.env instead
#            (see backend/.env.example).
#
# Setup:  cp .env.docker.example .env
# `.env` is git-ignored and must never be committed.
#
# Every variable compose actually references is listed below, with a working
# default. Only SECRET_KEY has to be changed before the stack will start.
#
# -----------------------------------------------------------------------------
# NO "$" IN ANY VALUE HERE
# -----------------------------------------------------------------------------
# Compose reads $NAME in this file as a reference to another variable and
# substitutes it away, so a value containing "$" reaches the container
# truncated — silently, with no error. Django's own get_random_secret_key()
# can emit "$", which is why the generator below is used instead.
#
# To keep a literal "$", either double it (KEY=aa$$bb) or single-quote the
# whole value (KEY='aa$bb'). Double quotes do NOT protect it.
#
# -----------------------------------------------------------------------------
# Quoting, otherwise
# -----------------------------------------------------------------------------
# Don't. Quotes are stripped, so KEY=hello and KEY="hello" are identical, and
# spaces need no quoting: KEY=a b c reads back as "a b c". Unlike Django's
# parser, compose keeps "#" inside a value (KEY=abc#def is fine) — but a space
# before it starts a comment, so KEY=abc #def reads back as just "abc".
# =============================================================================


# =============================================================================
# REQUIRED
# =============================================================================

# Cryptographic signing key for sessions, CSRF, password-reset links and JWTs.
# Compose refuses to start the stack while this is unset.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-QmT4wZ8xLpK2vNhR6yBdFsA9cJeGuY3nXkV7tMwPzS5rHbCgD


# =============================================================================
# Django
# =============================================================================

# production is the right module for a container: DEBUG off, JSON-only API,
# security headers on. Use config.settings.development to debug inside Docker.
DJANGO_SETTINGS_MODULE=config.settings.production

DEBUG=False

# Hosts Django will serve. "web" is the compose service name, needed so the
# container healthcheck and inter-service calls are accepted.
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Origins allowed to call the API and to open a notifications websocket.
# Must match the address the browser loads the frontend from.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Public URL of the frontend; every link in an outgoing email is built from it.
FRONTEND_URL=http://localhost:3000

# TLS normally terminates at a proxy in front of this stack, not at Django.
# Set True only if the container itself is the TLS endpoint.
SECURE_SSL_REDIRECT=False


# =============================================================================
# Database
# =============================================================================
# These create the database inside the postgres container AND build the
# DATABASE_URL handed to Django, so the two can never disagree.
# Change POSTGRES_PASSWORD for anything reachable beyond your machine.
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora


# =============================================================================
# Host ports
# =============================================================================
# Only affects how you reach the stack from your machine. Traffic between
# containers always uses the service names (db:5432, redis:6379), so changing
# these never breaks anything internally.
# Change any that clash with something already running locally.
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379


# =============================================================================
# Frontend
# =============================================================================
# Baked into the browser bundle at BUILD time, so it must be the URL a browser
# can reach — not the internal "web" hostname. Changing it needs a rebuild:
#   docker compose up --build frontend
# Keep the port in step with BACKEND_PORT above.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1


# =============================================================================
# Email
# =============================================================================
# The default prints messages to the worker's container log, which is enough
# for a demo — read an invitation or password-reset link with:
#   docker compose logs worker
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For real delivery, switch the backend and fill in the SMTP settings.
# Gmail requires an App Password, not your account password.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Nexora <no-reply@nexora.app>


# =============================================================================
# AI — optional
# =============================================================================
# Embeddings and semantic search run locally and need no key. A provider key is
# only required for the chat assistant itself.
AI_LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Fernet key encrypting per-workspace API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Blank derives one from SECRET_KEY, which means rotating SECRET_KEY makes
# stored provider keys unreadable. Set a dedicated key for anything real.
AI_FIELD_ENCRYPTION_KEY=


# =============================================================================
# Not set here
# =============================================================================
# docker-compose.yml builds these from the values above, so they must NOT be
# set in this file:
#   DATABASE_URL  -> postgres://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/POSTGRES_DB
#   REDIS_URL     -> redis://redis:6379/0
# Everything else (JWT lifetimes, throttle rates, chunking and retrieval
# tuning) uses the defaults compiled into config/settings/. To override one,
# add it to the `environment:` block of the web and worker services — adding it
# here alone has no effect, because compose only forwards what that block names.
