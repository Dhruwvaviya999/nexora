# =============================================================================
# Backend environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored and must never be committed.
# =============================================================================

# Which settings module to load. Leave as development locally; deploys set
# this to config.settings.production in their own environment.
DJANGO_SETTINGS_MODULE=config.settings.development

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Cryptographic signing key for sessions, CSRF, password resets, etc.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# Toggle debug mode. MUST be False in production (verbose errors leak internals).
DEBUG=True

# -----------------------------------------------------------------------------
# Hosts
# -----------------------------------------------------------------------------
# Comma-separated host/domain names Django will serve. In production list your
# real domains, e.g. api.example.com,example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Database (single PostgreSQL instance)
# -----------------------------------------------------------------------------
# Connection string parsed by django-environ:
#   postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://nexora:nexora@localhost:5432/nexora

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated front-end origins allowed to call the API (scheme + host + port).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# JWT (SimpleJWT) — tokens are wired up, auth endpoints come in Phase 2
# -----------------------------------------------------------------------------
# Access token lifetime in minutes (short-lived).
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
# Refresh token lifetime in days (longer-lived).
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Optional dedicated signing key for JWTs. If omitted, SECRET_KEY is used.
JWT_SIGNING_KEY=

# -----------------------------------------------------------------------------
# AI / RAG (Phase 5)
# -----------------------------------------------------------------------------
# Default LLM provider for chat/summaries: gemini | openai | ollama.
# Per-workspace AI Settings (set in the UI) override these.
AI_LLM_PROVIDER=gemini
AI_CHAT_MODEL=gemini-2.0-flash
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024

# Embeddings. Default is the local Sentence Transformers model (no key needed).
# EMBEDDING_DIM is fixed at 384 in code/migrations for this model.
AI_EMBEDDING_PROVIDER=sentence_transformer
AI_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Provider API keys (fallbacks; per-workspace keys take precedence).
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Fernet key encrypting per-workspace API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, a key is derived from SECRET_KEY (acceptable for development only).
AI_FIELD_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Production-only (safe to leave unset in development)
# -----------------------------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000

# -----------------------------------------------------------------------------
# Redis (cache, Celery broker, Channels layer)
# -----------------------------------------------------------------------------
# Optional in development: without it, throttling uses local memory, websockets
# use an in-process layer and Celery tasks run inline. All three need a real
# Redis once you run more than one process.
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Development defaults to the console backend, which prints messages to the
# terminal. Switch to SMTP for real delivery.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Nexora <no-reply@nexora.app>

# Public URL of the frontend. Every link in an outgoing email is built from it,
# so it must be the address recipients can actually open.
FRONTEND_URL=http://localhost:3000

# How long a password-reset link stays valid, in seconds (default 24 hours).
PASSWORD_RESET_TIMEOUT=86400

# -----------------------------------------------------------------------------
# Background jobs (Celery)
# -----------------------------------------------------------------------------
# Development runs tasks inline. Set this to False and start a worker
# (celery -A config worker -l info) to process embeddings out of band.
# CELERY_TASK_ALWAYS_EAGER=False
# CELERY_BROKER_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Rate limits (DRF throttling)
# -----------------------------------------------------------------------------
# Defaults shown. Tighten or loosen per environment.
THROTTLE_ANON=60/min
THROTTLE_USER=1000/hour
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_AI=30/hour
