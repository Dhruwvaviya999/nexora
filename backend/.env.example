# =============================================================================
# Backend environment — read by Django itself
# -----------------------------------------------------------------------------
# Read by:   django-environ, via config/settings/base.py -> read_env(BASE_DIR/".env")
# Used when: you run Django directly (python manage.py runserver / test / celery)
# Ignored:   inside Docker — .dockerignore keeps .env out of the image, and the
#            container gets its settings from docker-compose.yml instead.
#            For Docker, edit the .env in the repo root (see .env.docker.example).
#
# Setup:  cp .env.example .env
# `.env` is git-ignored and must never be committed.
#
# Only DATABASE_URL and SECRET_KEY have to be filled in; every other variable
# below is shown with the default the code already uses, so you can delete any
# line you don't need. Values are real, working examples — not placeholders.
#
# -----------------------------------------------------------------------------
# Quoting
# -----------------------------------------------------------------------------
# Don't quote. Quotes are stripped, so KEY=hello and KEY="hello" are identical,
# and spaces need no quoting either: KEY=a b c reads back as "a b c".
#
# Two characters do matter, and quoting does NOT rescue either:
#   #  ends the value. KEY=abc#def reads back as "abc" — and KEY="abc#def"
#      reads back as '"abc', which is worse. Keep "#" out of values entirely.
#   $  as the FIRST character makes the value a reference to another variable,
#      in every quoting style. An unknown target raises ImproperlyConfigured at
#      startup, so it fails loudly rather than silently. A "$" anywhere else in
#      the value is fine.
# =============================================================================


# =============================================================================
# REQUIRED
# =============================================================================

# Cryptographic signing key for sessions, CSRF, password-reset links and JWTs.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Avoid a value that *starts* with "$" — django-environ reads a leading "$" as a
# reference to another variable.
SECRET_KEY=dev-only-key-replace-me-BQ8xUqk2LhV3nZpR7wTfYsA6mDcJeGyN4bXvK9

# PostgreSQL connection, parsed by django-environ:
#   postgres://USER:PASSWORD@HOST:PORT/DBNAME
# The database must have the pgvector extension available:
#   CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nexora


# =============================================================================
# Core Django
# =============================================================================

# Which settings module to load. `manage.py test` overrides this with
# config.settings.test automatically; deploys set config.settings.production.
DJANGO_SETTINGS_MODULE=config.settings.development

# Verbose error pages. MUST be False in production — they leak source and
# settings. Defaults to True in the development settings.
DEBUG=True

# Comma-separated hosts Django will serve. In production list your real domains,
# e.g. api.example.com,example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated front-end origins allowed to call the API (scheme + host + port).
# This list also decides which origins may open a notifications websocket.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public base URL of the Next.js app. Every link in an outgoing email is built
# from this, so it must be an address recipients can actually open.
FRONTEND_URL=http://localhost:3000


# =============================================================================
# JWT (SimpleJWT)
# =============================================================================

# Access token lifetime in minutes (short-lived; refreshed transparently).
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15

# Refresh token lifetime in days.
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# How long a password-reset link stays valid, in seconds (default 24 hours).
PASSWORD_RESET_TIMEOUT=86400


# =============================================================================
# Redis — optional locally
# =============================================================================
# Without Redis: throttle counters live in local memory, websockets use an
# in-process channel layer, and Celery tasks run inline. That is enough to run
# and test everything on one machine. All three need a real Redis as soon as
# more than one process serves traffic.
REDIS_URL=redis://localhost:6379/0

# Override individually only if they live on different instances. Each defaults
# to REDIS_URL.
# CACHE_URL=redis://localhost:6379/1
# CHANNEL_LAYER_URL=redis://localhost:6379/2


# =============================================================================
# Background jobs (Celery)
# =============================================================================
# Development runs tasks inline, so no worker or broker is needed. Set this to
# False and start a worker to process document embedding out of band:
#   celery -A config worker --loglevel=info
CELERY_TASK_ALWAYS_EAGER=True

# Default to REDIS_URL; set only if the broker differs.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Embedding a large PDF is slow, but not unbounded (seconds).
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=660


# =============================================================================
# Email
# =============================================================================
# Development defaults to the console backend, which prints messages to the
# terminal — invitations and password-reset links included. No SMTP needed.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For real delivery, switch the backend and fill in the SMTP settings.
# Gmail requires an App Password, not your account password.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10

# From address on every outgoing message.
DEFAULT_FROM_EMAIL=Nexora <no-reply@nexora.app>


# =============================================================================
# Rate limits (DRF throttling)
# =============================================================================
# Format is "<number>/<period>", period one of: second, minute, hour, day.
# The credential scopes are keyed by IP, the rest by user.
THROTTLE_ANON=60/min
THROTTLE_USER=1000/hour
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/hour
THROTTLE_PASSWORD_RESET=5/hour
# LLM calls cost money per request.
THROTTLE_AI=30/hour


# =============================================================================
# AI / RAG
# =============================================================================

# Chat provider for the assistant: gemini | openai | ollama.
# Per-workspace AI Settings (set in the UI) override these at runtime.
AI_LLM_PROVIDER=gemini
AI_CHAT_MODEL=gemini-2.0-flash
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024

# Hard cap on user-supplied prompt length (prompt-injection / abuse guard).
AI_MAX_INPUT_CHARS=4000

# Embeddings. The default runs locally and needs no API key; the model is
# downloaded on first use (~90MB).
# EMBEDDING_DIM is fixed at 384 for this model, and is baked into the pgvector
# column — changing the model to a different dimensionality needs a migration.
AI_EMBEDDING_PROVIDER=sentence_transformer
AI_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking and retrieval tuning.
AI_CHUNK_SIZE_WORDS=220
AI_CHUNK_OVERLAP_WORDS=40
AI_EMBED_BATCH_SIZE=32
AI_SEARCH_TOP_K=6
# Cosine distance above which a chunk is considered irrelevant
# (0 = identical .. 2 = opposite; similarity = 1 - distance).
AI_SEARCH_MAX_DISTANCE=0.75

# Provider API keys — only needed for the chat assistant, not for embeddings.
# Per-workspace keys entered in the UI take precedence over these.
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Fernet key encrypting per-workspace API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Blank derives a key from SECRET_KEY — acceptable for development only, and it
# means rotating SECRET_KEY makes stored provider keys unreadable.
AI_FIELD_ENCRYPTION_KEY=


# =============================================================================
# Production only
# =============================================================================
# Ignored by the development settings; listed here so the full set is visible.
# Leave SECURE_SSL_REDIRECT False when TLS terminates at a proxy in front of the
# app rather than at Django itself.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000
